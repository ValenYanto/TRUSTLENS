PROJECT_NAME=TrustLens API
API_VERSION=v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trustlens
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens_password

DATABASE_URL=postgresql+psycopg2://trustlens:trustlens_password@postgres:5432/trustlens

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trustlens_neo4j_password
NEO4J_PLUGINS=[]

JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

AUTO_MIGRATE=true
AUTO_SEED=true

ADAPTIVE_RETRAIN_MIN_LABELS=5
ADAPTIVE_RETRAIN_LIMIT_ROWS=200000

HOST_FRONTEND_PORT=3000
HOST_BACKEND_PORT=8000
HOST_POSTGRES_PORT=5432
HOST_NEO4J_HTTP_PORT=7474
HOST_NEO4J_BOLT_PORT=7687
