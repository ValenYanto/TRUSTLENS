generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InvestorInquiry {
  id          String @id @default(cuid())
  inquiryCode String @unique @db.VarChar(32)

  fullName    String @db.VarChar(100)
  companyName String @db.VarChar(120)
  jobTitle    String @db.VarChar(100)
  email       String @db.VarChar(150)
  whatsapp    String @db.VarChar(30)
  country     String @db.VarChar(80)

  investorType    InvestorType
  interestType    InvestmentInterest
  investmentRange InvestmentRange
  focusArea       InvestorFocusArea

  preferredMeetingDate DateTime? @db.Date
  message              String    @db.Text
  consentAccepted      Boolean

  status         InvestorInquiryStatus @default(NEW)
  documentStatus DocumentStatus        @default(PENDING)
  emailStatus    EmailDeliveryStatus   @default(PENDING)

  internalNotes String? @db.Text
  failureReason String? @db.Text

  pdfGeneratedAt      DateTime?
  internalEmailSentAt DateTime?
  investorEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([companyName])
  @@index([investorType])
  @@index([interestType])
  @@index([status])
  @@index([createdAt])
  @@map("investor_inquiries")
}

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum InvestorType {
  ANGEL_INVESTOR
  VENTURE_CAPITAL
  CORPORATE_VENTURE
  FINANCIAL_INSTITUTION
  STRATEGIC_PARTNER
  OTHER
}

enum InvestmentInterest {
  EQUITY_INVESTMENT
  STRATEGIC_PARTNERSHIP
  PILOT_COLLABORATION
  TECHNOLOGY_PARTNERSHIP
  ADVISORY
  OTHER
}

enum InvestmentRange {
  BELOW_100_MILLION
  BETWEEN_100_AND_500_MILLION
  BETWEEN_500_MILLION_AND_1_BILLION
  ABOVE_1_BILLION
  NOT_DECIDED
}

enum InvestorFocusArea {
  PRODUCT_DEVELOPMENT
  AI_AND_DATA
  INSTITUTIONAL_PILOT
  BUSINESS_EXPANSION
  SECURITY_AND_COMPLIANCE
  OTHER
}

enum InvestorInquiryStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUALIFIED
  FOLLOW_UP
  CLOSED
  REJECTED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  PARTIALLY_SENT
  FAILED
}
